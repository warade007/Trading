# Documentation only: the application does not load .env.
# Enter broker API credentials only at /settings/broker/ after administrator login.
# These are fixed safety settings in config/settings.py, not runtime switches.
RESEARCH_MODE=true
LIVE_TRADING_ENABLED=false
# SQLite is always project-local: data/research.sqlite3
# Server is restricted to 127.0.0.1; no network services required.
# Windows default: scripts/security_keys.py init creates a current-user DPAPI vault
# outside the project/database, containing separate Django and broker keys.
# Advanced protected-process environment overrides (never paste actual keys here):
# DJANGO_SECRET_KEY: independent random string, 50+ characters.
# BROKER_FERNET_KEYS: JSON array of Fernet keys, primary first, old keys retained.
